# Copie para .env.local (não vai para o Git) e preencha. Na Vercel, cadastre as mesmas variáveis.
# String de conexão do Neon (Dashboard > Connect > "Pooled connection")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Senha para entrar no painel /admin.html
ADMIN_PASSWORD=troque-esta-senha
# Texto aleatório longo para assinar a sessão (trocar invalida os logins)
SESSION_SECRET=gere-um-texto-aleatorio-longo
